<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.web.front.mapper.HotelOrderInfoMapper">

    <resultMap id="BaseResultMap" type="com.travel.model.pojo.HotelOrderInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="hotelId" column="hotel_id" jdbcType="BIGINT"/>
            <result property="roomId" column="room_id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="number" column="number" jdbcType="INTEGER"/>
            <result property="price" column="price" jdbcType="DECIMAL"/>
            <result property="paymentType" column="payment_type" jdbcType="VARCHAR"/>
            <result property="startTime" column="start_time" jdbcType="DATE"/>
            <result property="endTime" column="end_time" jdbcType="DATE"/>
            <result property="state" column="state" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="note" column="note" jdbcType="VARCHAR"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,hotel_id,room_id,
        user_id,number,price,payment_type,
        start_time,end_time,state,create_time,
        update_time,note,is_deleted
    </sql>
    <select id="pageQuery" resultType="com.travel.web.front.vo.hotel.HotelOrderVo">
        select
            hoi.id,
            hoi.hotel_id,
            hoi.room_id,
            hoi.user_id,
            hoi.number,
            hoi.price,
            hoi.payment_type,
            hoi.start_time,
            hoi.end_time,
            hoi.state,
            hoi.create_time,
            hi.name as hotelName,
            hi.province,
            hi.city,
            hi.district,
            hi.address,
            ri.name as roomName
        from hotel_order_info hoi
        left join hotel_info hi on hoi.hotel_id = hi.id
        left join room_info ri on hoi.room_id = ri.id
        where hoi.user_id = #{userId}
        order by hoi.start_time desc
    </select>
</mapper>
