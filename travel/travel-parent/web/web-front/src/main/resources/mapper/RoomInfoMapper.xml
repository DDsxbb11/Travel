<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.web.front.mapper.RoomInfoMapper">

    <resultMap id="BaseResultMap" type="com.travel.model.pojo.RoomInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="hotelId" column="hotel_id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="imgUrl" column="img_url" jdbcType="VARCHAR"/>
            <result property="price" column="price" jdbcType="DECIMAL"/>
            <result property="number" column="number" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,hotel_id,name,
        img_url,price,number,
        create_time,update_time,is_deleted
    </sql>
    <select id="selectRoomList" resultMap="SelectRoomMap">
        select
            id,hotel_id,name,img_url,price,number
        from room_info
        where hotel_id=#{hotelId} and is_deleted = 0
    </select>
    <resultMap id="SelectRoomMap" type="com.travel.web.front.vo.hotel.RoomVo" autoMapping="true">
        <id column="id" property="id" />
        <collection
                property="roomFacilityList"
                ofType="com.travel.model.pojo.FacilityInfo"
                select="SELECT_ROOM_FACILITY"
                column="id=id"
                autoMapping="true"
        />
        <collection
                property="bathroomFacilityList"
                ofType="com.travel.model.pojo.FacilityInfo"
                select="SELECT_BATHROOM_FACILITY"
                column="id=id"
                autoMapping="true"
        />
        <collection
                property="foodFacilityList"
                ofType="com.travel.model.pojo.FacilityInfo"
                select="SELECT_FOOD_FACILITY"
                column="id=id"
                autoMapping="true"
        />
    </resultMap>

    <select id="SELECT_ROOM_FACILITY" resultType="com.travel.model.pojo.FacilityInfo">
        select
            fi.id,
            fi.name,
            fi.svg_url,
            f.sort
        from item_facility f
                 INNER join facility_info fi on fi.id = f.facility_id
        where f.item_id = #{id} and f.type='room_facility' and f.is_deleted = 0
        order by f.sort desc
    </select>
    <select id="SELECT_BATHROOM_FACILITY" resultType="com.travel.model.pojo.FacilityInfo">
        select
            fi.id,
            fi.name,
            fi.svg_url,
            f.sort
        from item_facility f
                 INNER join facility_info fi on fi.id = f.facility_id
        where f.item_id = #{id} and f.type='bathroom_facility' and f.is_deleted = 0
        order by f.sort desc
    </select>
    <select id="SELECT_FOOD_FACILITY" resultType="com.travel.model.pojo.FacilityInfo">
        select
            fi.id,
            fi.name,
            fi.svg_url,
            f.sort
        from item_facility f
                 INNER join facility_info fi on fi.id = f.facility_id
        where f.item_id = #{id} and f.type='food_facility' and f.is_deleted = 0
        order by f.sort desc
    </select>
</mapper>
