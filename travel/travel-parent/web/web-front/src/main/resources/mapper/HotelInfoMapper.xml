<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travel.web.front.mapper.HotelInfoMapper">

    <resultMap id="BaseResultMap" type="com.travel.model.pojo.HotelInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="imgUrl" column="img_url" jdbcType="VARCHAR"/>
            <result property="level" column="level" jdbcType="VARCHAR"/>
            <result property="province" column="province" jdbcType="VARCHAR"/>
            <result property="city" column="city" jdbcType="VARCHAR"/>
            <result property="district" column="district" jdbcType="VARCHAR"/>
            <result property="address" column="address" jdbcType="VARCHAR"/>
            <result property="longitude" column="longitude" jdbcType="VARCHAR"/>
            <result property="latitude" column="latitude" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="rating" column="rating" jdbcType="DECIMAL"/>
            <result property="openTime" column="open_time" jdbcType="VARCHAR"/>
            <result property="roomNumber" column="room_number" jdbcType="INTEGER"/>
            <result property="phone" column="phone" jdbcType="VARCHAR"/>
            <result property="trafficDesc" column="traffic_desc" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,img_url,
        level,province,city,
        district,address,longitude,
        latitude,description,rating,
        open_time,room_number,phone,
        traffic_desc,create_time,update_time,
        is_deleted
    </sql>

    <select id="getPage" resultType="com.travel.web.front.vo.hotel.HotelVo">
        SELECT
        hi.id,
        hi.name,
        hi.address,
        hi.level,
        hi.rating,
        MIN(ri.price) AS minPrice,
        MAX(ri.price) AS maxPrice,
        hi.img_url
        FROM
        hotel_info hi
        LEFT JOIN
        room_info ri ON hi.id = ri.hotel_id
        <where>
            <if test="queryVo != null">
                <if test="queryVo.province != null and queryVo.province != ''">
                    AND hi.province = #{queryVo.province}
                </if>
                <if test="queryVo.city != null and queryVo.city != ''">
                    AND hi.city = #{queryVo.city}
                </if>
                <if test="queryVo.district != null and queryVo.district != ''">
                    AND hi.district = #{queryVo.district}
                </if>
                <if test="queryVo.levelList != null and queryVo.levelList.size() > 0">
                    AND hi.level IN
                    <foreach collection="queryVo.levelList" item="level" open="(" separator="," close=")">
                        #{level}
                    </foreach>
                </if>
            </if>
        </where>
        GROUP BY
        hi.id, hi.name, hi.address, hi.level, hi.rating, hi.img_url
        <if test="queryVo != null">
            <if test="queryVo.minPrice != null or queryVo.maxPrice != null">
                HAVING 1=1
                <if test="queryVo.minPrice != null">
                    AND MIN(ri.price) &gt; #{queryVo.minPrice}
                </if>
                <if test="queryVo.maxPrice != null">
                    or MAX(ri.price) &lt; #{queryVo.maxPrice}
                </if>
            </if>
        </if>
    </select>
</mapper>
